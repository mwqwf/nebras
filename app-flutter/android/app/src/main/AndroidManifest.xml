<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- REQUIRED for network video -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- إشعارات FCM: مطلوب منذ Android 13 (API 33) للسماح بعرض الإشعارات -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- ▶︎ تشغيل صوتيّ في الخلفية عبر just_audio_background.
         FOREGROUND_SERVICE: مطلوب للـ Service الذي يُبقي التشغيل حيّاً.
         FOREGROUND_SERVICE_MEDIA_PLAYBACK: إضافيّ منذ Android 14 (API 34)
         لتمييز نوع الخدمة وتفادي الرفض من النظام. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true">

            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
            />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- يسمح لخدمة FCM بفتح الصفحة المقصودة عند النقر على الإشعار -->
            <intent-filter>
                <action android:name="FLUTTER_NOTIFICATION_CLICK"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>

        </activity>

        <!-- ▶︎ خدمة التشغيل الخلفيّة لـ just_audio_background.
             تُبقي المشغّل حيّاً حتى بعد إغلاق الشاشة وتُظهر الإشعار الدائم.
             مُصدَّرة (`exported="true"`) لأنّ MediaBrowserService يستلزم
             ذلك ليتفاعل مع نظام Android (Android Auto / Wear OS / Cast). -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>

        <!-- ▶︎ المستقبِل الذي يحوّل أزرار الوسائط (سمّاعات/سيارة/ساعات)
             إلى أوامر تشغيل/إيقاف داخل المشغّل. -->
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- قناة الإشعارات الافتراضية: يجب أن تطابق الـ channel_id
             المُنشأ في firebase_notification_datasource.dart -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="nebras_notifications" />

        <!-- أيقونة الإشعار الافتراضية: vector drawable أحاديّ اللون
             (silhouette أبيض) كما يفرض Android ≥ 5.0. تمرير أيقونة ملوّنة
             يُنتج مربّعاً أبيض صلباً في شريط الحالة. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />

        <!-- لون التمييز الذي يستخدمه النظام لتلوين الـ silhouette. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/ic_notification_accent"
            tools:replace="android:resource" />

    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- مطلوب لـ url_launcher على Android 11+ (R / API 30) حتى يستطيع
             التطبيق رؤية المتصفحات المثبّتة على الجهاز وفتح الروابط فيها
             من مكوّن AutoLinkText. https://developer.android.com/training/package-visibility -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
    </queries>

</manifest>
