{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --prefix dashboard",
  "buildCommand": "npm run build --prefix dashboard && rm -rf .vercel/output && mkdir -p .vercel && cp -r dashboard/.vercel/output .vercel/output",
  "framework": null,
  "crons": [
    {
      "path": "/api/cron/aggregates-popularity",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/internet-archive-tick",
      "schedule": "0 2 * * *"
    }
  ]
}
