{
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "dashboard/firestore.rules",
    "indexes": "dashboard/firestore.indexes.json",
    "database": "default"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "apphosting": [
    {
      "backendId": "nebras-dashboard",
      "rootDir": "./dashboard",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "dashboard/node_modules",
        "dashboard/.svelte-kit",
        "dashboard/build",
        "dashboard/.env",
        "dashboard/.env.*",
        "dashboard/secrets"
      ],
      "alwaysDeployFromSource": true
    }
  ]
}
