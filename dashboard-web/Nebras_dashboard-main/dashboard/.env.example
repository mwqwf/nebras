# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000

# Firebase — انسخ هذا الملف إلى .env وعبّئ القيم من إعدادات مشروعك
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ─── Firebase Admin SDK — Nebras (server-side — never prefix with VITE_) ──
# مفتاح خدمة المشروع الأساسيّ. يُستخدم لإرسال إشعارات FCM والتحقّق من ID
# tokens وقراءة/كتابة dashboard_users. اتركه فارغاً واستخدم الاسم الأحدث
# (NEBRAS_SERVICE_ACCOUNT_*) للمشاريع الجديدة — كلاهما مدعوم للتوافق الرجعي.
#
# تعليمات: Firebase Console → Project Settings → Service accounts → Generate
# new private key، ثمّ ضع محتوى الملف كاملاً كسلسلة واحدة (مع escape لأسطر
# private_key):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","...":"..."}
FIREBASE_SERVICE_ACCOUNT_JSON=

# (اختياري) مسار ملف JSON بدل إلصاقه نصاً في المتغيّر أعلاه.
FIREBASE_SERVICE_ACCOUNT_PATH=

# (بديل أحدث — مستحسن) نفس المفتاح أعلاه لكن بأسماء صريحة تميّز Nebras
# عن باقي المشاريع. إن ضُبط أيّ منها فله الأسبقيّة على FIREBASE_SERVICE_ACCOUNT_*.
NEBRAS_SERVICE_ACCOUNT_JSON=
NEBRAS_SERVICE_ACCOUNT_PATH=
# متغيّر موحّد اختياري يقبل JSON مدمجاً أو مساراً (Heuristic).
NEBRAS_SERVICE_ACCOUNT=

# اسم الـ topic الذي تشترك فيه جميع الأجهزة في التطبيق.
# يجب أن يتطابق مع القيمة المستخدمة داخل التطبيق (انظر firebase_notification_datasource.dart).
FCM_BROADCAST_TOPIC=nebras_all_users

# ─── Crawl4AI sidecar (server-side — optional) ───────────────────────
# شغّل خدمة Python داخل `dashboard/crawl4ai_service` (انظر start.ps1 / start.sh)
# ثم اضبط عنوانها هنا ليتصل بها SvelteKit من الخادم فقط.
CRAWL4AI_SERVICE_URL=http://127.0.0.1:8790
# اختياري: نفس القيمة داخل crawl4ai_service/.env لحماية الواجهة HTTP
CRAWL4AI_SERVICE_SECRET=
# اختياري: مهلة الاتصال بالخدمة (مللي ثانية)
CRAWL4AI_FETCH_TIMEOUT_MS=120000

# ─── Owner Code Secret (server-side — مهم جداً) ─────────────────────
# سرّ عشوائي قويّ (≥32 محرف) لتجزئة OTP المالك قبل تخزينه. ولّد قيمة جديدة بـ:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
OWNER_CODE_SECRET=

# ─── Puppeteer (لاجتياز حماية Cloudflare على noor-book.com) ─────────
# المحرّك الآلي يستعمل Puppeteer + stealth-plugin لاختراق تحدّي
# Cloudflare. يُشغّل Chromium حقيقي في الخلفية. تأكّد من تثبيت الحزم
# التالية (مدرَجة في package.json كـ optionalDependencies):
#   - puppeteer
#   - puppeteer-extra
#   - puppeteer-extra-plugin-stealth
#
# ─── Vercel Cron + GitHub Action ─────────────────────────────────────
# تُمرَّر تلقائياً كـ Authorization: Bearer … إلى:
#   GET /api/cron/aggregates-popularity   (يومياً عبر Vercel Cron)
#   GET /api/cron/internet-archive-tick   (يومياً عبر Vercel Cron + كل 10 دقائق عبر GitHub Action)
#
# Vercel Hobby = cron يومي فقط (https://vercel.com/docs/cron-jobs/usage-and-pricing).
# لذا يكمّله GitHub Action في .github/workflows/ia-cron.yml كل 10 دقائق.
#
# اتركه فارغاً = الـ endpoint سيقبل بدون auth (مفيد للنشر السريع على Hobby).
# لو ضبطته: ضع نفس القيمة في Vercel env + GitHub repo secret باسم CRON_SECRET.
CRON_SECRET=

# ─── Public Base URL (server-side — مهم لمحرّك Internet Archive) ──────
# عنوان النشر العامّ للوحة. يُستعمل لبناء روابط الـ proxy المطلقة التي
# يكتبها محرّك IA في Firestore ويستهلكها تطبيق Flutter:
#   {NEBRAS_PUBLIC_BASE_URL}/api/proxy/ia/{fileId}.{ext}
# لا يحوي "archive.org" فيمرّ حارس التطبيق (content_model._rejectArchiveOrg).
# اتركه فارغاً ليُستنبط من VERCEL_PROJECT_PRODUCTION_URL أو القيمة الافتراضيّة.
NEBRAS_PUBLIC_BASE_URL=https://nebras-dashboard-main.vercel.app

# ⚠️ هذا يعمل فقط في بيئات تدعم Chromium (محلياً، Docker، VPS). على
# Vercel Serverless استعمل cron خارجي يطرق /engine/tick بدل الحلقة الداخليّة.
NOOR_USE_PUPPETEER=true
PUPPETEER_HEADLESS=true
# (اختياري) مسار Chromium مخصّص — اتركه فارغاً ليُحمَّل تلقائياً مع puppeteer.
# مثال على ويندوز: C:\Program Files\Google\Chrome\Application\chrome.exe
PUPPETEER_EXECUTABLE_PATH=

# ── وسيط تجاوز Cloudflare لمكتبة نور (اختياريّ، بديل crawl4ai بلا نشر) ──
# مفتاح من أي خدمة scraping (ScraperAPI/ScrapingBee/ZenRows). {url} يُستبدل بالهدف.
# مثال: https://api.scraperapi.com/?api_key=KEY&render=true&url={url}
SCRAPER_API_URL_TEMPLATE=
# (اختياريّ) قالب منفصل لتنزيل الملفّات الثنائيّة (PDF) — render=false غالباً.
SCRAPER_API_DOWNLOAD_TEMPLATE=
